# SCANN Native Annotation - Environment Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=80

# Dataset Configuration (local path on the host)
# This will be mounted to /app/dataset inside the container
# SCANN_NATIVE_DATASET_ROOT=/app/dataset (set in docker-compose.yml)

# Task Lock Timeout (in seconds)
SCANN_NATIVE_TASK_LOCK_TIMEOUT_SECONDS=1200
