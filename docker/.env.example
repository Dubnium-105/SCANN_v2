# Public web port exposed by the frontend container.
FRONTEND_PORT=8080

# Optional direct backend exposure. Keep localhost-only unless you really need it.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Runtime dataset directory on the Linux server.
# Can be relative to docker/ or an absolute host path such as /srv/scann/dataset.
SCANN_DATASET_DIR=./runtime/dataset

# Optional image overrides for regions where docker.io is slow or blocked.
# Examples:
# PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:20-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
DEBIAN_MIRROR=deb.debian.org
DEBIAN_SECURITY_MIRROR=security.debian.org

# Security settings.
SCANN_NATIVE_JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-bytes
SCANN_NATIVE_JWT_EXPIRE_MINUTES=120
SCANN_PRELABEL_WORKER_TOKEN=change-this-to-a-long-random-prelabel-worker-token
SCANN_TRAINING_WORKER_TOKEN=change-this-to-a-long-random-training-worker-token
SCANN_WORKER_OFFLINE_SECONDS=180

# Optional native GPU worker deployment (docker-compose.workers.yml).
SCANN_WORKER_IMAGE=scann/native-worker:local
SCANN_IMAGE_REVISION=unknown
SCANN_TRAINING_SERVER_URL=http://backend:8000
SCANN_PRELABEL_SERVER_URL=http://backend:8000
SCANN_PRELABEL_WORKER_MODEL_PATH=/data/dataset/.scann_control/models/model-id/model-id.pth
SCANN_PRELABEL_WORKER_MODEL_VERSION=V2-11-vit
SCANN_PRELABEL_WORKER_MODEL_ID=model-id
SCANN_PRELABEL_WORKER_MODEL_FORMAT=auto
SCANN_PRELABEL_WORKER_MODEL_BACKBONE=ViT_B_16

# Application tuning.
SCANN_NATIVE_TASK_LOCK_TIMEOUT_SECONDS=1200

# Optional PostgreSQL annotation backup/sync.
# Keep this file in KEY=value format. Do not write KEY: value or KEY = value.
SCANN_ANNOTATION_SYNC_ENABLED=false
SCANN_ANNOTATION_SYNC_DATABASE_URL=
SCANN_ANNOTATION_SYNC_DATASET_ID=
SCANN_ANNOTATION_SYNC_SCHEMA=scann_backup
SCANN_ANNOTATION_SYNC_INTERVAL_SECONDS=300
SCANN_ANNOTATION_SYNC_CONNECT_TIMEOUT_SECONDS=10
