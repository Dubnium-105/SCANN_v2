{
  "experiment_name": "legacy_vit_h14_fullres_k4_stream_qjl",
  "dataset_dir": "../../../dataset",
  "manifest_path": "../manifests/legacy_v1_manifest.json",
  "output_root": "..",
  "model_name": "vit_h_14",
  "pretrained": true,
  "input_mode": "new_old_diff",
