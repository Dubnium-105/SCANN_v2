{
  "experiment_name": "legacy_vit_b16_exp8_refactored_ablation",
  "dataset_dir": "../../../dataset",
  "manifest_path": "../manifests/legacy_v1_manifest.json",
  "output_root": "..",
  "model_name": "vit_b_16",
  "pretrained": true,
  "input_mode": "new_old_diff",
  "image_size": 224,
  "resize_mode": "resize",
  "normalize": true,
  "attention_compression_mode": "none",
  "attention_layer_selector": "all",
  "attention_layer_count": 0,
  "enabled_layer_indices": [0, 5, 11],
  "kv_bits": 4,
  "group_size": 32,
  "token_block_size": 64,
  "preserve_cls_token": false,
  "quantize_k": true,
  "quantize_v": true,
  "streaming_enabled": false,
  "materialize_attention_matrix": true,
  "batch_size": 16,
  "epochs": 100,
  "lr": 0.00005,
  "weight_decay": 0.001,
  "optimizer": "AdamW",
  "scheduler": "cosine",
  "early_stopping_patience": 10,
  "selection_metric": "f1",
  "threshold_metric": "f1",
  "loss_name": "cross_entropy",
  "use_weighted_sampler": true,
  "augment": true,
  "horizontal_flip_prob": 0.5,
  "vertical_flip_prob": 0.5,
  "enable_rotate_90": true,
  "num_workers": 0,
  "seed": 42,
  "device": "auto",
  "train_ratio": 0.7,
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "log_every_n_steps": 25
}
